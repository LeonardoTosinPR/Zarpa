APP_NAME=Zarpa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=zarpa
DB_USERNAME=zarpa
DB_PASSWORD=zarpa_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Servidor OSRM Dedicado para Roteamento Viário (Basic Auth)
OSRM_BASE_URL=https://osrmcar.debug.app.br
OSRM_USERNAME=your_osrm_username
OSRM_PASSWORD=your_osrm_password

# Geocodificação (Nominatim / Photon / Pelias)
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

